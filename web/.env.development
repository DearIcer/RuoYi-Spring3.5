# 本地环境
VITE_USER_NODE_ENV = development

# 公共基础路径
VITE_PUBLIC_PATH = /

# 路由模式
# Optional: hash | history
VITE_ROUTER_MODE = hash

# 打包时是否删除 console
VITE_DROP_CONSOLE = true

# 是否开启 VitePWA
VITE_PWA = false

# RuoYi 后端接口地址
VITE_API_URL = http://localhost:8080

# 否开启代理
VITE_HTTP_PROXY = true

# 开发环境跨域代理，RuoYi后端默认端口为8080
# 只代理API请求，不代理静态文件
VITE_PROXY = [["/dev-api","http://localhost:8080"]]

#是否启用mqtt
VITE_MQTT = false

